{
  "name": "pasadena-mtb-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "DEMO_BUILD=true astro build",
    "build:release": "astro build --mode release",
    "preview": "astro preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "format:check": "prettier --plugin=prettier-plugin-astro --check src tests astro.config.mjs playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "maplibre-gl": "^6.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
