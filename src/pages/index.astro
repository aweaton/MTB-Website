---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Western Newfoundland">
  <main>
    <section class="hero">
      <div>
        <p class="eyebrow">WESTERN NEWFOUNDLAND / PASADENA</p>
        <h1>
          A little further.
          <br />A little wilder.
        </h1>
        <p class="intro">
          An early look at a mountain biking destination guide, between the
          hills and the water of Western Newfoundland.
        </p>
        <a class="button" href="/map/">
          Explore the fictional network ↗
        </a>
        <p class="caption">
          A design prototype. The routes shown here do not exist.
        </p>
      </div>
      <div
        class="landscape"
        role="img"
        aria-label="Abstract illustration of hills, forest and water"
      >
        <span>
          49° N / 57° W<br />
          PASADENA AREA
        </span>
      </div>
    </section>
    <section class="overview">
      <p class="eyebrow">THE FIRST FIELD NOTES</p>
      <h2>One place. Room to explore.</h2>
      <div class="cards">
        <article>
          <span>01 / THE PLACE</span>
          <h3>Pasadena</h3>
          <p>Our first destination in a future Western Newfoundland guide.</p>
        </article>
        <article>
          <span>02 / THE NETWORK</span>
          <h3>Three imaginary trails</h3>
          <p>
            A small synthetic network lets us try maps and trail details before
            verified data arrives.
          </p>
        </article>
        <article>
          <span>03 / THE RIDE</span>
          <h3>Pieces that connect</h3>
          <p>
            One featured loop reuses trail segments in an explicit order and
            direction.
          </p>
        </article>
      </div>
    </section>
  </main>
</Layout>
